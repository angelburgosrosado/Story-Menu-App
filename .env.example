# .env.example
# PostgreSQL Connection URL
DATABASE_URL=postgresql://your_user:***@your_host:5432/your_database

# Redis / Upstash URL for BullMQ background jobs
REDIS_URL=redis://localhost:6379

# Google Gemini API Key (keep this server-side only)
GEMINI_API_KEY=

# Administrator Email for Backend Access
ADMIN_EMAIL=your_email@example.com

# URL of the deployed/local application
APP_URL=http://localhost:3001

# Google OAuth Credentials (for Firebase/NextAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# E2E Testing Safe Auth Configuration
E2E_AUTH_ENABLED=true
E2E_AUTH_SECRET=local-test-secret-1234
E2E_EMAIL_ALLOWLIST=abglco@protonmail.com,angelburgosrosado@gmail.com
