{
  "name": "infinite-heroes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p tmp && TMPDIR=./tmp tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "validate:deploy": "npm run build && node validate-deployment.cjs",
    "test": "vitest"
  },
  "dependencies": {
    "@google/genai": "^1.27.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.98",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "heic2any": "^0.0.4",
    "i18next": "^26.3.1",
    "jspdf": "^3.0.3",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.8",
    "recharts": "^3.3.0",
    "stripe": "^22.2.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.22.3",
    "typescript": "~5.8.2",
    "vitest": "^2.0.5"
  }
}
