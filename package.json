{
  "name": "infinite-heroes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p tmp && TMPDIR=./tmp tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "validate:deploy": "npm run build && node validate-deployment.cjs",
    "test": "node test-db-queries.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.27.0",
    "express": "^5.2.1",
    "firebase": "^12.14.0",
    "jspdf": "^3.0.3",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "pg": "^8.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.3",
    "typescript": "~5.8.2"
  }
}
